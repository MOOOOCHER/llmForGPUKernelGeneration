+def decode_json_list(data_item, field_name: str, default_empty: bool = False):
+    """Decode JSON-list parquet fields while preserving native nested values."""
+    if data_item is None or (
+        isinstance(data_item, (float, np.floating)) and np.isnan(data_item)
+    ):
+        if default_empty:
+            return []
+        raise ValueError(f"{field_name} must not be null")
+    if isinstance(data_item, str):
+        data_item = json.loads(data_item)
+    data_item = convert_nested_value_to_list_recursive(data_item)
+    if not isinstance(data_item, list):
+        raise ValueError(f"{field_name} must decode to a list, got {type(data_item).__name__}")
+    return data_item
+
